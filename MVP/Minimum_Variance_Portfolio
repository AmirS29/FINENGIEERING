#to use MVP
    #weights sum to 1 and find the optimal ones according to the minimized risk
    #Covariance matrix
    #expected return
    #risk or volatility (standard deviation)
    #investor fixes expected return and minimizes the risk
    #use log utility function for efficient frontier
    #optimization will be aided by scipy

#computes the percentage change of each stock from the previous day
#dropna() removes anything missing
returns = data.pct_change().dropna()
#calculates the average daily return of each stock
mean_returns = returns.mean()
#computes the covariance in a matrix between each stock
cov_matrix = returns.cov()


#number of assets
num_assets = len(stocks)

#assigns initial equal weights
weights = np.array([1/num_assets] * num_assets)

#weights need to be between 0 and 1 and sum up to 1
constraints = ({'type': 'eq', 'fun': lambda x: np.sum(x) - 1})
bounds = tuple((0, 1) for _ in range(num_assets))

#calculates the returns and risks given the weights, average returns, and covariance
def portfolio_performance(weights, mean_returns, cov_matrix):
    returns = np.dot(weights, mean_returns)
    risk = np.sqrt(np.dot(weights.T, np.dot(cov_matrix, weights)))
    return returns, risk

#minimizes risk for a given return
def minimize_risk(weights, mean_returns, cov_matrix):
    return portfolio_performance(weights, mean_returns, cov_matrix)[1]

#calls the function to minimize risk using the contraints, bounds, mean returns, and
#covariance
optimized = minimize(minimize_risk, weights, args=(mean_returns, cov_matrix),
                     method='SLSQP', bounds=bounds, constraints=constraints)
#optimization uses SLSQP(Sequential Least SQuares Programming) 
#an optimizer that minimizes a function of multiple variables while considering 
#any combination of constraints, including bounds, equality, and inequality


#results
opt_weights = optimized.x
opt_return, opt_risk = portfolio_performance(opt_weights, mean_returns, cov_matrix)

print("Optimal Portfolio Weights:")
for ticker, weight in zip(stocks, opt_weights):
    print(f'{ticker}: {weight*100:.2f}%')

print("Expected Return:", opt_return)
print("Risk (Volatility):", opt_risk)


#plot the efficient frontier
risks = []
returns_list = []
for ret in np.linspace(mean_returns.min(), mean_returns.max(), 100):
    constraints = ({'type': 'eq', 'fun': lambda x: np.sum(x) - 1},
                   {'type': 'eq', 'fun': lambda x: np.dot(x, mean_returns) - ret})
    optimized = minimize(minimize_risk, weights, args=(mean_returns, cov_matrix),
                         method='SLSQP', bounds=bounds, constraints=constraints)
    if optimized.success:
        risks.append(optimized.fun)
        returns_list.append(ret)

plt.figure(figsize=(10, 6))
plt.plot(risks, returns_list, label='Efficient Frontier')
plt.scatter(opt_risk, opt_return, color='red', marker='*', label='MVP')
plt.title('Efficient Frontier and Minimum Variance Portfolio')
plt.xlabel('Risk (Volatility)')
plt.ylabel('Expected Return')
plt.legend()
plt.grid(True)
plt.show()
